---
import siteData from "../data/site.yml";
import type { SiteContent } from "../lib/types";

const site = siteData as unknown as SiteContent;
const icons: Record<string, string> = {
  github:
    "M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.34 1.08 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02a9.6 9.6 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.18.58.69.48A10 10 0 0 0 12 2z",
  linkedin:
    "M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21H9z",
  x: "M17.75 3h3.07l-6.7 7.66L22 21h-6.17l-4.83-6.32L5.47 21H2.4l7.17-8.2L2 3h6.33l4.37 5.78zm-1.08 16.2h1.7L7.4 4.73H5.58z",
  email:
    "M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm9 7.2L4 7.4V17h16V7.4zM5.2 7l6.8 4.1L18.8 7z",
  credly:
    "M12 2l2.4 1.8 3-.2.9 2.9 2.5 1.7-1 2.8 1 2.8-2.5 1.7-.9 2.9-3-.2L12 20l-2.4-1.8-3 .2-.9-2.9-2.5-1.7 1-2.8-1-2.8 2.5-1.7.9-2.9 3 .2zm-1 12.6l5.3-5.3-1.4-1.4-3.9 3.9-1.9-1.9-1.4 1.4z",
};
const year = new Date().getFullYear();
---

<footer class="mt-12 border-t line">
  <div class="max-w-[960px] mx-auto px-5 lg:px-10 py-5 flex flex-col sm:flex-row items-center justify-between gap-3 font-mono text-xs mute">
    <div>© {year} {site.footer.name} · {site.footer.credit}</div>
    <div class="flex gap-4">
      {
        site.footer.socials.map((link) => (
          <a href={link.href} aria-label={link.label} title={link.label} class="hover:text-primary" target="_blank" rel="noopener">
            {icons[link.icon] ? (
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                <path d={icons[link.icon]} />
              </svg>
            ) : (
              <span>{link.label}</span>
            )}
          </a>
        ))
      }
    </div>
  </div>
</footer>
