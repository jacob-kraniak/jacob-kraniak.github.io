---
import siteData from "../data/site.yml";
import type { Project, SiteContent } from "../lib/types";
import { isPlaceholder } from "../lib/richText";

interface Props {
  p: Project;
  detailed?: boolean;
}

const { p, detailed = false } = Astro.props;
const site = siteData as unknown as SiteContent;
const href = p.url || (p.repo ? `https://github.com/${site.identity.githubUser}/${p.repo}` : null);
const Tag = href ? "a" : "div";
---

<Tag
  href={href ?? undefined}
  target={href ? "_blank" : undefined}
  rel={href ? "noopener" : undefined}
  class="block rounded-box border line bg-base-200 p-4 hover:border-primary transition"
>
  <div class="flex items-center justify-between font-mono text-[11px]">
    <span class="text-primary">[{p.tag}]</span><span class="mute">{p.status}</span>
  </div>
  <h3 class="font-mono text-sm font-semibold mt-1">{p.title}</h3>
  <p class:list={["text-sm mt-1 leading-snug", p.placeholder || isPlaceholder(p.summary) ? "ph" : "mute"]}>{p.summary}</p>
  {
    detailed && (
      <ul class="font-mono text-xs mt-3 space-y-1">
        {p.notes.map((note) => (
          <li>
            <span class="text-primary">›</span> <span class={isPlaceholder(note) ? "ph" : undefined}>{note}</span>
          </li>
        ))}
        <li class:list={[isPlaceholder(p.next) ? "ph" : "mute"]}>next: {p.next}</li>
      </ul>
    )
  }
  <div class="flex flex-wrap gap-1 mt-3">{p.stack.map((item) => <span class="chip">{item}</span>)}</div>
</Tag>
