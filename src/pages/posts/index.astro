---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import pageData from "../../data/posts.yml";
import siteData from "../../data/site.yml";
import type { PostsPage, SiteContent } from "../../lib/types";
import { getPublicPosts } from "../../lib/posts";

const page = pageData as unknown as PostsPage;
const site = siteData as unknown as SiteContent;
const posts = await getPublicPosts();
---

<BaseLayout title={page.documentTitle} sideBarActiveItemID="posts">
  <div class="flex items-baseline justify-between gap-3">
    <div class="font-mono text-xs text-primary">{page.prompt}</div>
    <a class="font-mono text-xs link link-secondary" href={site.rss}>{page.rssLabel}</a>
  </div>
  <h1 class="text-2xl font-bold mt-1 mb-1">{page.heading}</h1>
  <p class="text-sm mute mb-6 max-w-2xl">{page.lede}</p>
  {posts.length > 0 ? <PostList posts={posts} projectLabels={page.projectLabels} /> : <p class="text-sm mute">{page.empty}</p>}
</BaseLayout>
