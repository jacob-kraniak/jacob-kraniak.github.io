---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import pageData from "../../../data/posts.yml";
import type { PostsPage } from "../../../lib/types";
import { getPublicPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  const projects = [...new Set(posts.map((post) => post.data.project))];
  return projects.map((project) => ({ params: { project } }));
}

const page = pageData as unknown as PostsPage;
const { project } = Astro.params;
if (!project) throw new Error("Missing project");
const posts = (await getPublicPosts()).filter((post) => post.data.project === project);
const label = page.projectLabels[project] ?? project;
---

<BaseLayout title={`posts · ${label} · Jacob Kraniak`} sideBarActiveItemID="posts">
  <div class="font-mono text-xs text-primary">$ ls ~/posts/{project}</div>
  <h1 class="text-2xl font-bold mt-1 mb-1">{label}</h1>
  <p class="text-sm mute mb-6">
    <a class="link link-secondary" href="/posts">all posts</a>
    {page.projectLinks[project] && (
      <>
        {" · "}
        <a class="link link-secondary" href={page.projectLinks[project]}>initiative</a>
      </>
    )}
  </p>
  <PostList posts={posts} projectLabels={page.projectLabels} />
</BaseLayout>
