---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import pageData from "../../../data/posts.yml";
import type { PostsPage } from "../../../lib/types";
import { getPublicPosts } from "../../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublicPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag } }));
}

const page = pageData as unknown as PostsPage;
const { tag } = Astro.params;
if (!tag) throw new Error("Missing tag");
const posts = (await getPublicPosts()).filter((post) => post.data.tags.includes(tag));
---

<BaseLayout title={`posts · ${tag} · Jacob Kraniak`} sideBarActiveItemID="posts">
  <div class="font-mono text-xs text-primary">$ ls ~/posts --tag {tag}</div>
  <h1 class="text-2xl font-bold mt-1 mb-1">{tag}</h1>
  <p class="text-sm mute mb-6"><a class="link link-secondary" href="/posts">all posts</a></p>
  <PostList posts={posts} projectLabels={page.projectLabels} />
</BaseLayout>
