---
import BaseLayout from "../layouts/BaseLayout.astro";
import SummaryCard from "../components/SummaryCard.astro";
import CertRow from "../components/CertRow.astro";
import QuoteRotator from "../components/QuoteRotator.astro";
import homeData from "../data/home.yml";
import initiativeData from "../data/datacenter-build.yml";
import reposData from "../data/repos.yml";
import siteData from "../data/site.yml";
import certFile from "../data/certs.json";
import type { CertFile, HomeContent, InitiativePage, ReposPage, SiteContent } from "../lib/types";
import { isPlaceholder } from "../lib/richText";

const home = homeData as unknown as HomeContent;
const initiative = initiativeData as unknown as InitiativePage;
const repos = reposData as unknown as ReposPage;
const site = siteData as unknown as SiteContent;
const certs = certFile as CertFile;
const featured = home.featured.map((item) => {
  if (item.kind === "initiative") {
    if (initiative.id !== item.id) {
      throw new Error(`Home features initiative ${item.id}, but src/data/datacenter-build.yml is ${initiative.id}`);
    }
    return { kind: "initiative" as const, page: initiative };
  }
  const repo = repos.items.find((entry) => entry.id === item.id);
  if (!repo) throw new Error(`Home features unknown repo id ${item.id}`);
  return { kind: "repo" as const, repo };
});
---

<BaseLayout sideBarActiveItemID="home">
  <section class="pb-8">
    <div class="font-mono text-xs text-primary">{home.prompt}</div>
    <h1 class="text-3xl lg:text-4xl font-bold mt-1">{home.name}</h1>
    <p class="font-mono text-sm mute mt-1">{home.role}</p>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed">{home.bio}</p>
    {
      home.researchFocus && (
        <p class:list={["text-xs mt-2", isPlaceholder(home.researchFocus) && "ph"]}>{home.researchFocus}</p>
      )
    }
    <QuoteRotator prompt={home.quotePrompt} quotes={home.quotes} />
  </section>

  <section class="pb-8">
    <div class="flex items-baseline justify-between">
      <div class="h-sec">{home.projectsHeading}</div>
      <a href={home.projectsHref} class="font-mono text-xs link link-secondary">{home.projectsLinkLabel}</a>
    </div>
    <div class="grid gap-3 md:grid-cols-2">
      {
        featured.map((item) =>
          item.kind === "initiative" ? (
            <SummaryCard
              href={`/${item.page.id}`}
              tag={item.page.tag}
              status={item.page.status}
              title={item.page.heading}
              summary={item.page.summary}
              stack={item.page.stack}
            />
          ) : (
            <SummaryCard
              href={`https://github.com/${site.identity.githubUser}/${item.repo.repo}`}
              external
              tag={item.repo.tag ?? item.repo.status}
              status={item.repo.status}
              title={item.repo.title}
              summary={item.repo.summary}
              stack={item.repo.stack}
            />
          )
        )
      }
    </div>
  </section>

  <section class="pb-8">
    <div class="flex items-baseline justify-between">
      <div class="h-sec">{home.certsHeading}</div>
      <a href={home.certsHref} class="font-mono text-xs link link-secondary">{home.certsLinkLabel}</a>
    </div>
    <CertRow />
    <p class="font-mono text-xs mute mt-2">
      {home.certNextPrefix} {certs.next.join(" → ")} · {home.certVerified}{" "}
      <a class="link link-secondary" href={certs.profile}>{home.certProfileLabel}</a>
    </p>
  </section>

  <section>
    <div class="h-sec">{home.stackHeading}</div>
    <div class="flex flex-wrap gap-1">{home.stack.map((item) => <span class="chip">{item}</span>)}</div>
  </section>
</BaseLayout>
