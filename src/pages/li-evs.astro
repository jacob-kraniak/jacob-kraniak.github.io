---
import BaseLayout from "../layouts/BaseLayout.astro";
import RichText from "../components/RichText.astro";
import pageData from "../data/li-evs.yml";
import type { LiEvsPage } from "../lib/types";

const page = pageData as unknown as LiEvsPage;
---

<BaseLayout title={page.documentTitle} sideBarActiveItemID="li-evs">
  <div class="font-mono text-xs text-primary">{page.prompt}</div>
  <h1 class="text-2xl font-bold mt-1 mb-1">{page.heading}</h1>
  <p class="text-sm mute mb-6 max-w-2xl">{page.lede}</p>

  <section class="pb-8">
    <div class="h-sec">{page.missionHeading}</div>
    <ul class="font-mono text-sm space-y-1 max-w-2xl">
      {page.mission.map((item) => (
        <li><span class="text-primary">›</span> {item}</li>
      ))}
    </ul>
  </section>

  <section class="pb-8">
    <div class="h-sec">{page.socialsHeading}</div>
    <ul class="font-mono text-sm space-y-1">
      {page.socials.map((item) => (
        <li>
          <span class="text-primary">›</span> {item.label}:{" "}
          <a class="link link-secondary" href={item.href} target="_blank" rel="noopener">{item.handle}</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="pb-8">
    <div class="h-sec">{page.newsHeading}</div>
    <ul class="font-mono text-sm space-y-2 max-w-2xl">
      {page.news.map((item) => (
        <li><span class="text-primary">›</span> <RichText text={item} /></li>
      ))}
    </ul>
  </section>

  <p class="font-mono text-xs mute">
    {page.sourceLabel}{" "}
    <a class="link link-secondary" href={page.sourceHref} target="_blank" rel="noopener">{page.sourceText}</a>
  </p>
</BaseLayout>
